# Copy this file to .streamlit/secrets.toml and fill in real values.
# Do NOT commit secrets.toml — it's in .gitignore.

sheet_id = "YOUR_GOOGLE_SHEET_ID"
worksheet_name = "Form_Responses"

HF_API_TOKEN = "hf_..."   # optional, enables AI comment summaries

# Optional; defaults to reviews.sqlite3 beside app.py.
review_database_path = "reviews.sqlite3"
# These accounts can sign in to see the review approval portal.
review_admin_emails = ["admin@columbia.edu"]

[gcp_service_account]
# Give this service account Editor access to the source worksheet so approved
# reviews can be appended. The review form itself still uses local SQLite.
type = "service_account"
project_id = "your-gcp-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@your-gcp-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# ----- Optional Columbia-email login gate (Google OAuth) -----
# Set to true to require Google sign-in restricted to columbia.edu emails.
# Leave false (or delete the line) to keep the app public.
enable_auth = false
allowed_email_domains = ["columbia.edu"]

# Required when enable_auth = true. Fill in from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client IDs).
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "GENERATE_A_LONG_RANDOM_STRING_AND_PASTE_IT_HERE"

[auth.google]
client_id = "..."
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
